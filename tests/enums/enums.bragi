enum Foo {
	A = 1,
	B,
	C = 4,
	D,
	E,
	F
}

consts Bar uint8 {
	A = 1,
	B,
	C = 4,
	D = 2,
	E,
	F
}

message Test 1 {
head(128):
	Foo foo;
	Bar bar;
	Foo[] foos;
	Bar[4] bars;
}

consts Baz uint32 {
	A = 1,
	B = 4096
}

struct Nested {
	Bar bar;
	Bar[] bars;
	Baz baz;
	Baz[] bazs;
	Foo foo;
	Foo[] foos;
}

message Test2 2 {
head(128):
	Nested nested;
}
